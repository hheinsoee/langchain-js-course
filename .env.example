# Copy to .env and fill in ONE provider. src/model.ts auto-detects which.

# --- Option A: any OpenAI-compatible gateway (Sargalay, OpenRouter, ...) ---
# The `openai` provider class works unchanged; only the base URL differs.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.sargalay.com/v1
LC_MODEL=google/gemini-2.5-flash-lite
LC_EMBED_MODEL=text-embedding-3-small

# --- Option B: OpenAI directly -------------------------------------------
# Set OPENAI_API_KEY and leave OPENAI_BASE_URL unset.
# https://platform.openai.com/api-keys

# --- Option C: Anthropic --------------------------------------------------
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# --- Option D: Google Gemini (free tier) ---------------------------------
# https://aistudio.google.com/apikey
# GOOGLE_API_KEY=

# --- Option E: Ollama, fully local, no key -------------------------------
# brew install ollama && ollama serve
# ollama pull qwen3:8b && ollama pull nomic-embed-text
# OLLAMA_MODEL=qwen3:8b

# --- Overrides ------------------------------------------------------------
# Force a provider when several keys are present: openai | anthropic | google-genai | ollama
# LC_PROVIDER=

# --- Optional: LangSmith tracing (see every step of every chain) ----------
# https://smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=langchain-course
